    <NuGetAudit>false</NuGetAudit>
    <LidarrSrc Condition="'$(LidarrSrc)' == ''">$(MSBuildThisFileDirectory)..\..\Submodules\Lidarr\src</LidarrSrc>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ArtistArt\ArtistArt.csproj" />
    <ProjectReference Include="$(LidarrSrc)\NzbDrone.Common\Lidarr.Common.csproj" />
    <ProjectReference Include="$(LidarrSrc)\NzbDrone.Core\Lidarr.Core.csproj" />
  </ItemGroup>
</Project>
